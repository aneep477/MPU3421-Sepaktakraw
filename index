  function askConfirmation(message) {
    return typeof window.confirm !== "function" || window.confirm(message);
  }

  function validatePracticalModeration(outcome) {
    var p1Total = scoreTotal(outcome._p1 && outcome._p1.scores);
    var p2Total = scoreTotal(outcome._p2 && outcome._p2.scores);
    var finalTotal = scoreTotal(outcome.scores);
    if (p1Total === null || p2Total === null || finalTotal === null) throw makeError("Kedua-dua assessment dan outcome mesti mempunyai tiga skor.");
    var gap = Math.abs(p1Total - p2Total);
    var extreme = p1Total < 30 || p1Total >= 54 || finalTotal < 30 || finalTotal >= 54;
    if (gap >= 5 && (!outcome.reviewRoundComplete || !outcome.panelReference.trim())) throw makeError("Perbezaan sekurang-kurangnya 5 mata memerlukan semakan kedua dan rujukan panel.");
    if (extreme && !outcome.panelReference.trim()) throw makeError("Skor ekstrem (<30 atau ≥54) memerlukan rujukan panel.");
    if (!extreme && gap < 5 && outcome.scores.some(function (value, index) { return value !== outcome._p1.scores[index]; })) throw makeError("Perbezaan kurang 5 mata: markah Penilai 1 dikekalkan.");
  }

  function runMutation(payload, successText) {
    if (state.busy) return Promise.resolve();
    var expectedEpoch = state.epoch;
    setBusy(true);
    return request(payload, expectedEpoch).then(function () {
      ensureEpoch(expectedEpoch);
      return syncSnapshot(expectedEpoch, successText);
    }).catch(function (error) {
      finishError(error, expectedEpoch);
      throw error;
    }).finally(function () {
      if (expectedEpoch === state.epoch) {
        setBusy(false);
        render();
      }
    });
  }

  function savePractical(student, status) {
    if (!student || state.role === null) return Promise.resolve();
    var built = buildPractical(student, status);
    var scoresComplete = built.assessment.scores.every(function (value) { return value !== null && validScore(value); });
    if (status === "submitted" && (!scoresComplete || !built.assessment.feedback.trim())) {
      showMessage("Lengkapkan tiga skor antara 0 hingga 20 dan maklum balas sebelum menghantar.", "error");
      return Promise.resolve();
    }
    if (status === "submitted" && !askConfirmation("Hantar assessment ini? Selepas dihantar, rekod Penilai " + state.role + " tidak boleh diubah.")) return Promise.resolve();
    return runMutation({ action: "save", assessment: built.assessment, expectedVersion: built.previous ? built.previous.version : 0 }, status === "submitted" ? "Assessment dihantar dan dikunci." : "Draf assessment berjaya disimpan.");
  }

  function saveModeration(student) {
    if (!student || state.role !== "P2") return Promise.resolve();
    var outcome = buildOutcome(student);
    if (!outcome._p1 || !outcome._p2 || outcome._p1.status !== "submitted" || outcome._p2.status !== "submitted") {
      showMessage("Kedua-dua assessment perlu dihantar sebelum moderasi.", "error");
      return Promise.resolve();
    }
    if (!outcome.reason.trim() || outcome.scores.some(function (value) { return !validScore(value); })) {
      showMessage("Lengkapkan tiga skor keputusan dan sebab moderasi.", "error");
      return Promise.resolve();
    }
    if (!askConfirmation("Sahkan moderasi amali? Outcome ialah rekod immutable dan tidak boleh diubah.")) return Promise.resolve();
    var clean = { studentId: outcome.studentId, scores: outcome.scores, reason: outcome.reason, approvedBy: "P2", approvedAt: outcome.approvedAt, reviewRoundComplete: outcome.reviewRoundComplete, panelReference: outcome.panelReference };
    try { validatePracticalModeration(Object.assign({}, outcome, { scores: clean.scores, reason: clean.reason, panelReference: clean.panelReference })); } catch (error) { showMessage(friendlyError(error), "error"); return Promise.resolve(); }
    return runMutation({ action: "moderate", outcome: clean }, "Keputusan amali disahkan.");
  }

  function saveGroup() {
    if (state.role !== "P1") return Promise.resolve();
    var draft = activeGroupDraft();
    var clean = { id: draft.id, name: String(draft.name || "").trim(), studentIds: draft.studentIds.slice(), updatedAt: nowISO(), version: Number(draft.version || 0) };
    if (typeof Core.assertTrainingGroup === "function") {
      try { Core.assertTrainingGroup(clean, state.snapshot); } catch (error) { showMessage(friendlyError(error), "error"); return Promise.resolve(); }
    }
    var previous = state.snapshot.trainingGroups.find(function (group) { return group.id === clean.id; });
    return runMutation({ action: "training_group_save", group: clean, expectedVersion: previous ? previous.version : 0 }, "Kumpulan latihan berjaya disimpan.");
  }

  function saveTraining(group, status) {
    if (!group) return Promise.resolve();
    var built = buildTrainingAssessment(group, status);
    var completeScores = built.assessment.scores.every(function (value) { return value !== null && validScore(value); });
    if (status === "submitted" && (!completeScores || !built.assessment.feedback.trim())) {
      showMessage("Lengkapkan dua skor latihan antara 0 hingga 20 dan maklum balas sebelum menghantar.", "error");
      return Promise.resolve();
    }
    if (status === "submitted" && !askConfirmation("Hantar assessment latihan ini? Rekod akan dikunci.")) return Promise.resolve();
    if (typeof Core.assertTrainingAssessment === "function") {
      try { Core.assertTrainingAssessment(built.assessment, state.snapshot); } catch (error) { showMessage(friendlyError(error), "error"); return Promise.resolve(); }
    }
    return runMutation({ action: "training_save", assessment: built.assessment, expectedVersion: built.previous ? built.previous.version : 0 }, status === "submitted" ? "Assessment latihan dihantar dan dikunci." : "Draf latihan berjaya disimpan.");
  }

  function saveTrainingModeration(group) {
    if (!group || state.role !== "P2") return Promise.resolve();
    var outcome = buildTrainingOutcome(group);
    if (!outcome._p1 || !outcome._p2 || outcome._p1.status !== "submitted" || outcome._p2.status !== "submitted") {
      showMessage("Kedua-dua assessment latihan perlu dihantar sebelum moderasi.", "error");
      return Promise.resolve();
    }
    if (!outcome.reason.trim() || outcome.scores.some(function (value) { return !validScore(value); })) {
      showMessage("Lengkapkan dua skor keputusan latihan dan sebab moderasi.", "error");
      return Promise.resolve();
    }
    if (!askConfirmation("Sahkan moderasi latihan? Outcome kumpulan ialah immutable.")) return Promise.resolve();
    var clean = { groupId: outcome.groupId, scores: outcome.scores, reason: outcome.reason, approvedBy: "P2", approvedAt: outcome.approvedAt, reviewRoundComplete: outcome.reviewRoundComplete, panelReference: outcome.panelReference };
    if (typeof Core.assertTrainingModeration === "function") {
      try { Core.assertTrainingModeration(clean, state.snapshot); } catch (error) { showMessage(friendlyError(error), "error"); return Promise.resolve(); }
    }
    return runMutation({ action: "training_moderate", outcome: clean }, "Keputusan latihan disahkan.");
  }

  function printSlip(student) {
    if (!student || typeof Core.slipHtml !== "function") return;
    var popup = window.open("", "_blank");
    if (!popup) { showMessage("Popup cetakan disekat oleh pelayar. Benarkan popup dan cuba semula.", "error"); return; }
    try { popup.opener = null; } catch (ignore) { /* opener may already be protected */ }
    var html = Core.slipHtml(student, state.snapshot.assessments, outcomeFor(student.id), state.snapshot);
    popup.document.open();
    popup.document.write(html);
    popup.document.close();
    try { popup.focus(); } catch (ignoreFocus) { /* optional */ }
  }

  function printResults() {
    if (typeof Core.resultsHtml !== "function") return;
    var popup = window.open("", "_blank");
    if (!popup) { showMessage("Popup cetakan disekat oleh pelayar. Benarkan popup dan cuba semula.", "error"); return; }
    try { popup.opener = null; } catch (ignore) { /* optional */ }
    var filteredStudents = resultRows().map(function (item) { return item.student; });
    var html = Core.resultsHtml(filteredStudents, state.snapshot.assessments, state.snapshot.outcomes, state.snapshot);
    popup.document.open();
    popup.document.write(html);
    popup.document.close();
    try { popup.focus(); } catch (ignoreFocus) { /* optional */ }
  }

  function selectStudent(index) {
    var number = Number(index);
    if (!state.snapshot.students[number]) return;
    state.selected.studentIndex = number;
    state.screen = "students";
    state.mobileMenuOpen = false;
    render();
    var content = $("#screen-content");
    if (content) content.focus();
  }

  function selectGroup(index, kind) {
    var number = Number(index);
    if (!state.snapshot.trainingGroups[number]) return;
    if (kind === "edit") state.selected.groupIndex = number;
    else state.selected.trainingGroupIndex = number;
    render();
  }

  function toggleMobileMenu() {
    state.mobileMenuOpen = !state.mobileMenuOpen;
    var side = $("#side-nav");
    if (!side) return;
    if (window.innerWidth <= 980) {
      side.style.display = state.mobileMenuOpen ? "block" : "none";
      side.style.position = state.mobileMenuOpen ? "fixed" : "";
      side.style.left = state.mobileMenuOpen ? "11px" : "";
      side.style.right = state.mobileMenuOpen ? "11px" : "";
      side.style.top = state.mobileMenuOpen ? "74px" : "";
      side.style.zIndex = state.mobileMenuOpen ? "12" : "";
    }
  }

  function updateDraftFromElement(element) {
    var type = element.getAttribute("data-draft");
    var field = element.getAttribute("data-field");
    var scoreIndex = element.getAttribute("data-score-index");
    if (type === "practical") {
      var student = getStudent(element.getAttribute("data-student-index"));
      if (!student) return;
      var draft = state.drafts.practical[student.id] || { scores: [null, null, null], feedback: "" };
      state.drafts.practical[student.id] = draft;
      if (scoreIndex !== null) draft.scores[Number(scoreIndex)] = parseScore(element.value);
      else if (field) draft[field] = element.type === "checkbox" ? element.checked : element.value;
    } else if (type === "moderation") {
      var moderationStudent = getStudent(element.getAttribute("data-student-index"));
      if (!moderationStudent) return;
      var moderation = state.drafts.moderation[moderationStudent.id] || { scores: [null, null, null], reason: "", reviewRoundComplete: false, panelReference: "" };
      state.drafts.moderation[moderationStudent.id] = moderation;
      if (scoreIndex !== null) moderation.scores[Number(scoreIndex)] = parseScore(element.value);
      else if (field) moderation[field] = element.type === "checkbox" ? element.checked : element.value;
    } else if (type === "training") {
      var trainingGroup = getGroup(element.getAttribute("data-group-index"));
      if (!trainingGroup) return;
      var training = state.drafts.training[trainingGroup.id] || { scores: [null, null], feedback: "" };
      state.drafts.training[trainingGroup.id] = training;
      if (scoreIndex !== null) training.scores[Number(scoreIndex)] = parseScore(element.value);
      else if (field) training[field] = element.value;
    } else if (type === "training-moderation") {
      var moderationGroup = getGroup(element.getAttribute("data-group-index"));
      if (!moderationGroup) return;
      var trainingModeration = state.drafts.trainingModeration[moderationGroup.id] || { scores: [null, null], reason: "", reviewRoundComplete: false, panelReference: "" };
      state.drafts.trainingModeration[moderationGroup.id] = trainingModeration;
      if (scoreIndex !== null) trainingModeration.scores[Number(scoreIndex)] = parseScore(element.value);
      else if (field) trainingModeration[field] = element.type === "checkbox" ? element.checked : element.value;
    } else if (type === "group") {
      var groupDraft = activeGroupDraft();
      if (field) groupDraft[field] = element.value;
    } else if (type === "group-member") {
      var member = getStudent(element.getAttribute("data-student-index"));
      if (!member) return;
      var currentGroup = activeGroupDraft();
      var position = currentGroup.studentIds.indexOf(member.id);
      if (element.checked && position < 0) currentGroup.studentIds.push(member.id);
      if (!element.checked && position >= 0) currentGroup.studentIds.splice(position, 1);
    }
  }

  function handleInput(event) {
    var element = event.target;
    if (element.matches("[data-draft]")) updateDraftFromElement(element);
    if (element.matches('[data-filter="studentSearch"]')) { state.filters.studentSearch = element.value; render(); }
    if (element.matches('[data-filter="resultSearch"]')) { state.filters.resultSearch = element.value; render(); }
  }

  function handleChange(event) {
    var element = event.target;
    if (element.matches("[data-draft]")) updateDraftFromElement(element);
    if (element.matches('[data-filter="studentClass"]')) { state.filters.studentClass = element.value; render(); return; }
    if (element.matches('[data-filter="resultClass"]')) { state.filters.resultClass = element.value; render(); return; }
    if (element.matches('[data-select="student"]')) { selectStudent(element.value); return; }
    if (element.matches('[data-select="training-group"]')) { selectGroup(element.value, "training"); return; }
    if (element.matches('[data-select="edit-group"]')) { selectGroup(element.value, "edit"); return; }
  }

  function handleFormSubmit(event) {
    var form = event.target;
    if (!form.matches("form[data-form]")) return;
    event.preventDefault();
    if (state.busy) return;
    var formType = form.getAttribute("data-form");
    if (formType === "login") return login();
    if (formType === "practical") return savePractical(getStudent(form.getAttribute("data-student-index")), "draft");
    if (formType === "moderation") return saveModeration(getStudent(form.getAttribute("data-student-index")));
    if (formType === "group") return saveGroup();
    if (formType === "training") return saveTraining(getGroup(form.getAttribute("data-group-index") || state.selected.trainingGroupIndex), "draft");
    if (formType === "training-moderation") return saveTrainingModeration(getGroup(state.selected.trainingGroupIndex));
  }

  function login() {
    if (state.busy) return;
    var roleElement = $("input[name=role]:checked");
    var passwordElement = $("#login-password");
    var role = roleElement ? roleElement.value : "";
    var password = passwordElement ? passwordElement.value : "";
    if ((role !== "P1" && role !== "P2") || !password) { showMessage("Pilih peranan dan masukkan kata laluan.", "error"); return; }
    state.epoch += 1;
    var expectedEpoch = state.epoch;
    clearSession("", false);
    state.busy = true;
    setNotice($("#login-message"), "Mengesahkan login dan memuatkan roster…", "");
    request({ action: "login", role: role, password: password }, expectedEpoch).then(function (data) {
      ensureEpoch(expectedEpoch);
      if (!data || data.role !== role || typeof data.sessionToken !== "string" || !data.sessionToken.trim() || !data.expiresAtISO) throw makeError("Respons login backend tidak sah.", "LOGIN_INVALID");
      state.role = data.role;
      state.sessionToken = data.sessionToken;
      state.expiresAtISO = data.expiresAtISO;
      state.authenticated = true;
      scheduleExpiry();
      return syncSnapshot(expectedEpoch, "Log masuk berjaya. Data sebenar telah dimuatkan.");
    }).then(function () {
      ensureEpoch(expectedEpoch);
      state.busy = false;
      if (passwordElement) passwordElement.value = "";
      state.screen = "dashboard";
      render();
    }).catch(function (error) {
      if (error && error.code === "STALE_SESSION") return;
      if (expectedEpoch === state.epoch) {
        state.busy = false;
        if (error && error.code === "SESSION_INVALID") expireSession(expectedEpoch);
        else { clearSession(friendlyError(error), false); }
      }
    });
  }

  function syncAction() {
    if (!state.authenticated || state.busy) return;
    var expectedEpoch = state.epoch;
    setBusy(true);
    syncSnapshot(expectedEpoch, "Data terkini telah dimuatkan.").catch(function (error) { finishError(error, expectedEpoch); }).finally(function () {
      if (expectedEpoch === state.epoch) { setBusy(false); render(); }
    });
  }

  function actionClick(action, element) {
    if (action === "toggle-menu") return toggleMobileMenu();
    if (action === "sync") return syncAction();
    if (action === "logout") return clearSession("Anda telah log keluar. Sila log masuk semula.", true);
    if (action === "health") {
      state.screen = "health";
      render();
      return syncAction();
    }
    if (action === "open-student") return selectStudent(element.getAttribute("data-student-index"));
    if (action === "new-group") { state.selected.groupIndex = -1; delete state.drafts.groups.__new; state.screen = "training"; render(); return; }
    if (action === "submit-practical") return savePractical(getStudent(element.getAttribute("data-student-index")), "submitted");
    if (action === "submit-training") return saveTraining(getGroup(element.getAttribute("data-group-index")), "submitted");
    if (action === "acknowledge") {
      var student = getStudent(element.getAttribute("data-student-index"));
      if (!student || state.role !== "P1" || !outcomeFor(student.id)) return;
      if (!askConfirmation("Rekodkan bahawa borang bertandatangan pelajar telah diterima?")) return;
      return runMutation({ action: "acknowledge", studentId: student.id }, "Penerimaan borang bertandatangan direkod.");
    }
    if (action === "print-slip") return printSlip(getStudent(element.getAttribute("data-student-index")));
    if (action === "print-results") return printResults();
  }

  function handleClick(event) {
    var nav = event.target.closest ? event.target.closest("[data-nav]") : null;
    if (nav) {
      event.preventDefault();
      state.screen = nav.getAttribute("data-nav");
      state.mobileMenuOpen = false;
      var side = $("#side-nav"); if (side && window.innerWidth <= 980) side.style.display = "none";
      render();
      return;
    }
    var button = event.target.closest ? event.target.closest("[data-action]") : null;
    if (button) { event.preventDefault(); actionClick(button.getAttribute("data-action"), button); }
  }

  root.addEventListener("submit", handleFormSubmit);
  root.addEventListener("input", handleInput);
  root.addEventListener("change", handleChange);
  root.addEventListener("click", handleClick);

  window.addEventListener("resize", function () {
    var side = $("#side-nav");
    if (!side) return;
    if (window.innerWidth > 980) side.style.display = "";
    else if (!state.mobileMenuOpen) side.style.display = "none";
  });

  render();

  // Deliberately expose only read-only, current in-memory state for JSDOM checks.
  window.TakrawApp = {
    getSnapshot: function () {
      if (!state.authenticated) return EMPTY();
      return state.snapshot;
    },
    getState: function () {
      return {
        authenticated: state.authenticated,
        role: state.role,
        screen: state.screen,
        busy: state.busy,
        lastSyncAt: state.lastSyncAt,
        expiresAtISO: state.expiresAtISO
      };
    }
  };
}());
</script>
</body>
</html>
