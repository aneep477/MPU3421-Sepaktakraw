  }

  function request(payload, expectedEpoch) {
    if (!transport || typeof transport.request !== "function") {
      return Promise.reject(makeError("Sambungan Google belum tersedia. Gunakan index.html lengkap daripada pakej ini.", "BRIDGE_TIMEOUT"));
    }
    var body = Object.assign({}, payload || {});
    if (body.action !== "login") {
      if (!state.sessionToken) return Promise.reject(makeError("Sila log masuk dahulu.", "SESSION_INVALID"));
      body.sessionToken = state.sessionToken;
    }
    return Promise.resolve().then(function () { return transport.request(body); }).then(function (response) {
      try { ensureEpoch(expectedEpoch); } catch (stale) { throw stale; }
      return responseData(response);
    }).catch(function (error) {
      if (error && (error.code === "SESSION_INVALID" || error.code === "401" || error.status === 401)) {
        error.code = "SESSION_INVALID";
        handleSessionError(error, expectedEpoch);
      }
      throw error;
    });
  }

  function syncSnapshot(expectedEpoch, successText) {
    return request({ action: "sync" }, expectedEpoch).then(function (data) {
