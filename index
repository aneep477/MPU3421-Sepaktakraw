      } catch (error) {
        throw makeError(error && error.message ? error.message : "Respons data backend tidak sah.", "SNAPSHOT_INVALID");
      }
      if (!parsed || parsed.role !== state.role) throw makeError("Peranan respons backend tidak sepadan dengan sesi.", "SESSION_INVALID");
      state.snapshot = parsed;
      state.lastSyncAt = nowISO();
      state.health = { status: "ok", version: parsed.serviceVersion || "tidak dinyatakan", at: state.lastSyncAt };
      clearDrafts();
      if (successText) showMessage(successText, "success");
      return parsed;
    });
  }

