    var expires = Date.parse(state.expiresAtISO);
    if (!Number.isFinite(expires)) return;
    var delay = Math.max(0, Math.min(expires - Date.now(), 60 * 60 * 1000));
    var expectedEpoch = state.epoch;
    state.sessionTimer = window.setTimeout(function () {
