  function buildPractical(student, status) {
    var source = assessmentFor(student.id, state.role);
    var draft = state.drafts.practical[student.id] || { scores: source ? source.scores.slice() : [null, null, null], feedback: source ? source.feedback : "" };
    var assessment = {
      id: student.id + "-" + state.role,
      studentId: student.id,
      evaluator: state.role,
      scores: draft.scores.map(function (value) { return value === "" ? null : value; }),
      feedback: String(draft.feedback || ""),
      status: status,
      updatedAt: source ? source.updatedAt : "",
      version: source ? source.version : 0
    };
    return { assessment: assessment, previous: source };
  }

  function buildOutcome(student) {
    var p1 = assessmentFor(student.id, "P1");
    var p2 = assessmentFor(student.id, "P2");
    var current = outcomeFor(student.id);
    var draft = state.drafts.moderation[student.id] || { scores: p1 ? p1.scores.slice() : [null, null, null], reason: "", reviewRoundComplete: false, panelReference: "" };
    return {
      studentId: student.id,
      scores: draft.scores.map(function (value) { return value === null || value === undefined || value === "" ? null : Number(value); }),
      reason: String(draft.reason || ""),
      approvedBy: "P2",
