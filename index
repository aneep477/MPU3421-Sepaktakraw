<!doctype html>
<html lang="ms">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#14532d">
  <meta name="description" content="Takraw Pentaksiran MPU3421 — penilaian amali, latihan dan keputusan berasaskan Google Sheets.">
  <title>Takraw Pentaksiran · MPU3421</title>
  <style>
    :root {
      --forest-950: #0b2b1b;
      --forest-900: #123b25;
      --forest-800: #14532d;
      --forest-700: #1d6b3a;
      --forest-500: #3f8f57;
      --cream: #fffdf4;
      --cream-deep: #f6f0d9;
      --ink: #1b2b22;
      --muted: #68766e;
      --line: #dce4d6;
      --citrus: #f3c84b;
      --citrus-soft: #fff3be;
      --danger: #a32828;
      --danger-soft: #fde8e8;
      --success: #166534;
      --success-soft: #e6f6e9;
      --shadow: 0 18px 45px rgba(18, 59, 37, .10);
      --radius: 18px;
      --small-radius: 11px;
    }
    * { box-sizing: border-box; }
    html { min-width: 320px; background: var(--cream); }
    body {
      margin: 0;
      background: linear-gradient(135deg, #fffdf4 0%, #f8f6e9 55%, #eef5e9 100%);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.48;
    }
    button, input, select, textarea { font: inherit; }
    button, a, input, select, textarea { touch-action: manipulation; }
    button { cursor: pointer; }
    button:disabled, select:disabled, input:disabled, textarea:disabled { cursor: not-allowed; opacity: .62; }
    a { color: var(--forest-800); }
    .skip-link { position: absolute; left: -9999px; top: 8px; z-index: 20; padding: 10px 14px; background: var(--cream); border-radius: 8px; }
    .skip-link:focus { left: 8px; }
    .site-header {
      position: sticky; top: 0; z-index: 8;
      border-bottom: 1px solid rgba(220, 228, 214, .85);
      background: rgba(255, 253, 244, .94);
      backdrop-filter: blur(14px);
    }
    .header-inner, .page-shell, .site-footer-inner { width: min(1240px, calc(100% - 32px)); margin: 0 auto; }
    .header-inner { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .brand { display: inline-flex; align-items: center; gap: 11px; color: var(--forest-950); text-decoration: none; }
    .brand-mark { width: 41px; height: 41px; display: grid; place-items: center; color: var(--cream); background: var(--forest-800); border-radius: 13px 13px 13px 4px; font-weight: 900; letter-spacing: -.08em; box-shadow: 4px 4px 0 var(--citrus); }
    .brand-title { font-weight: 900; letter-spacing: -.035em; font-size: 1.02rem; }
    .brand-subtitle { display: block; color: var(--muted); font-weight: 650; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; }
    .header-actions { display: flex; align-items: center; gap: 9px; }
    .role-badge, .pill { display: inline-flex; align-items: center; gap: 7px; border-radius: 999px; padding: 7px 11px; font-size: .78rem; font-weight: 800; }
    .role-badge { color: var(--forest-900); background: var(--citrus-soft); }
    .pill { color: var(--forest-900); background: var(--success-soft); }
    .pill.neutral { color: var(--muted); background: #edf1ec; }
    .icon-button { width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 12px; color: var(--forest-900); background: var(--cream); font-weight: 900; }
    .menu-button { display: none; }
    .page-shell { padding: 28px 0 110px; }
    .login-layout { min-height: calc(100vh - 190px); display: grid; place-items: center; }
    .login-card { width: min(520px, 100%); padding: clamp(24px, 5vw, 48px); border: 1px solid var(--line); border-radius: 28px; background: rgba(255, 253, 244, .93); box-shadow: var(--shadow); }
    .eyebrow { margin: 0 0 7px; color: var(--forest-700); font-weight: 850; font-size: .76rem; letter-spacing: .13em; text-transform: uppercase; }
    h1, h2, h3 { color: var(--forest-950); line-height: 1.18; letter-spacing: -.035em; }
    h1 { margin: 0 0 13px; font-size: clamp(1.8rem, 4vw, 2.65rem); }
    h2 { margin: 0 0 12px; font-size: 1.35rem; }
    h3 { margin: 0 0 8px; font-size: 1.03rem; }
    p { margin: 0 0 11px; }
    .muted { color: var(--muted); }
    .small { font-size: .83rem; }
    .helper { color: var(--muted); font-size: .81rem; }
    .notice { margin: 18px 0; padding: 13px 15px; border: 1px solid #eadb9d; border-radius: var(--small-radius); color: #5f4b16; background: #fff9da; font-size: .88rem; }
    .notice.error { border-color: #f2c2c2; color: var(--danger); background: var(--danger-soft); }
    .notice.success { border-color: #bde4c6; color: var(--success); background: var(--success-soft); }
    .notice:empty { display: none; }
    .form-grid { display: grid; gap: 16px; }
    .form-grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .form-grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    label, .field-label { display: block; color: var(--forest-900); font-weight: 800; font-size: .84rem; }
    label > span, .field-label > span { display: block; margin-bottom: 6px; }
    input, select, textarea { width: 100%; border: 1px solid #cfdccc; border-radius: 11px; color: var(--ink); background: #fffef9; padding: 11px 12px; outline: none; }
    input:focus, select:focus, textarea:focus { border-color: var(--forest-500); box-shadow: 0 0 0 3px rgba(63, 143, 87, .16); }
    input[type="number"] { min-width: 0; }
    textarea { min-height: 94px; resize: vertical; }
    .score-input { text-align: center; font-weight: 850; font-variant-numeric: tabular-nums; }
    .button-row { display: flex; align-items: center; flex-wrap: wrap; gap: 9px; }
    .button { min-height: 44px; padding: 10px 15px; border: 1px solid transparent; border-radius: 11px; font-weight: 850; transition: transform .12s ease, box-shadow .12s ease, background .12s ease; }
    .button:hover:not(:disabled) { transform: translateY(-1px); }
    .button.primary { color: var(--cream); background: var(--forest-800); box-shadow: 0 7px 15px rgba(20, 83, 45, .16); }
    .button.secondary { color: var(--forest-900); border-color: var(--line); background: #fffef9; }
    .button.citrus { color: var(--forest-950); background: var(--citrus); }
    .button.danger { color: var(--danger); border-color: #efc2c2; background: var(--danger-soft); }
    .button.small-button { min-height: 38px; padding: 8px 11px; font-size: .82rem; }
    .login-role-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px; }
    .role-option { position: relative; }
    .role-option input { position: absolute; width: 1px; height: 1px; opacity: 0; }
    .role-option span { display: block; padding: 13px; border: 1px solid var(--line); border-radius: 12px; text-align: center; font-weight: 850; background: #fffef9; }
    .role-option input:checked + span { border-color: var(--forest-500); color: var(--forest-950); background: var(--citrus-soft); box-shadow: inset 0 0 0 2px var(--forest-500); }
    .app-layout { display: grid; grid-template-columns: 230px minmax(0, 1fr); align-items: start; gap: 26px; }
    .side-nav { position: sticky; top: 96px; padding: 13px; border: 1px solid var(--line); border-radius: 19px; background: rgba(255, 253, 244, .82); box-shadow: 0 9px 24px rgba(18, 59, 37, .05); }
    .side-nav-title { padding: 7px 9px 12px; color: var(--muted); font-size: .72rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
    .nav-list { display: grid; gap: 5px; margin: 0; padding: 0; list-style: none; }
    .nav-link { width: 100%; display: flex; align-items: center; gap: 10px; padding: 11px 10px; border: 0; border-radius: 11px; color: var(--muted); background: transparent; text-align: left; font-weight: 800; }
    .nav-link:hover, .nav-link.active { color: var(--forest-950); background: var(--citrus-soft); }
    .nav-icon { width: 23px; color: var(--forest-700); font-weight: 950; text-align: center; }
    .main-content { min-width: 0; }
    .screen-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin: 0 0 22px; }
    .screen-heading h1 { margin-bottom: 7px; }
    .screen-heading p { color: var(--muted); }
    .heading-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .card { border: 1px solid var(--line); border-radius: var(--radius); background: rgba(255, 253, 244, .88); box-shadow: 0 8px 24px rgba(18, 59, 37, .045); }
    .card-pad { padding: 20px; }
    .card + .card { margin-top: 17px; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 17px; }
    .stat-card { padding: 17px; border: 1px solid var(--line); border-radius: 16px; background: rgba(255, 253, 244, .9); }
    .stat-label { color: var(--muted); font-size: .79rem; font-weight: 750; }
    .stat-value { display: block; margin-top: 7px; color: var(--forest-950); font-size: 1.65rem; font-weight: 900; font-variant-numeric: tabular-nums; }
    .split-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(300px, .8fr); gap: 17px; }
    .section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 15px; }
    .section-head h2, .section-head h3 { margin: 0; }
    .table-wrap { width: 100%; overflow-x: auto; border: 1px solid var(--line); border-radius: 13px; }
    table { width: 100%; border-collapse: collapse; min-width: 650px; }
    th, td { padding: 11px 12px; border-bottom: 1px solid #e8eee4; vertical-align: top; text-align: left; font-size: .84rem; }
    th { color: var(--forest-900); background: #f6f7eb; font-size: .76rem; letter-spacing: .02em; text-transform: uppercase; }
    tr:last-child td { border-bottom: 0; }
    .data-table td:first-child, .data-table th:first-child { white-space: nowrap; }
    .status { display: inline-flex; align-items: center; padding: 5px 8px; border-radius: 999px; color: var(--forest-900); background: var(--success-soft); font-size: .72rem; font-weight: 850; white-space: nowrap; }
    .status.pending { color: #6b5616; background: var(--citrus-soft); }
    .status.locked { color: var(--danger); background: var(--danger-soft); }
    .student-list { display: grid; gap: 8px; }
    .student-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 60px; padding: 11px 13px; border: 1px solid var(--line); border-radius: 13px; background: #fffef9; }
    .student-primary { min-width: 0; }
    .student-name { color: var(--forest-950); font-weight: 850; }
    .student-meta { color: var(--muted); font-size: .77rem; }
    .empty-state { padding: 28px 18px; border: 1px dashed #cbd9c7; border-radius: 14px; color: var(--muted); text-align: center; }
    .score-panel { padding: 17px; border: 1px solid #d4e2ce; border-radius: 15px; background: #fbfdf3; }
    .score-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
    .score-grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .score-label { color: var(--muted); font-size: .75rem; font-weight: 850; text-align: center; }
    .score-total { display: flex; align-items: center; justify-content: space-between; margin-top: 13px; padding-top: 12px; border-top: 1px solid var(--line); color: var(--forest-900); font-weight: 850; }
    .score-total strong { font-size: 1.18rem; }
    .masked { color: var(--muted); font-style: italic; }
    .check-row { display: flex; align-items: flex-start; gap: 9px; padding: 9px 0; }
    .check-row input { width: 19px; height: 19px; flex: 0 0 auto; margin: 2px 0 0; accent-color: var(--forest-700); }
    .check-row label { font-weight: 700; }
    .group-list { display: grid; gap: 9px; }
    .group-option { display: flex; align-items: flex-start; gap: 10px; padding: 12px; border: 1px solid var(--line); border-radius: 13px; background: #fffef9; }
    .group-option input { width: 19px; height: 19px; flex: 0 0 auto; margin-top: 2px; accent-color: var(--forest-700); }
    .group-option.selected { border-color: var(--forest-500); box-shadow: inset 0 0 0 1px var(--forest-500); background: #f7fceb; }
    .group-option-name { font-weight: 850; }
    .group-option-meta { color: var(--muted); font-size: .78rem; }
    .rubric-card { overflow: hidden; }
    .rubric-title { display: flex; align-items: flex-start; justify-content: space-between; gap: 15px; padding: 18px 20px; background: var(--forest-900); color: var(--cream); }
    .rubric-title h3 { margin: 0; color: var(--cream); }
    .rubric-title p { margin: 5px 0 0; color: #d5e5d7; font-size: .81rem; }
    .rubric-body { padding: 18px 20px; }
    .phase { padding: 14px 0; border-bottom: 1px solid #e5ecdf; }
    .phase:last-child { border-bottom: 0; padding-bottom: 0; }
    .phase-title { color: var(--forest-800); font-size: .78rem; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
    .criteria-list { display: grid; gap: 8px; margin: 9px 0 0; padding-left: 19px; }
    .criteria-list li { padding-left: 3px; font-size: .85rem; }
    .band-grid { display: grid; gap: 8px; }
    .band-item { display: grid; grid-template-columns: 148px 100px minmax(0, 1fr); gap: 11px; align-items: start; padding: 10px 0; border-bottom: 1px solid #e5ecdf; font-size: .82rem; }
    .band-item:last-child { border-bottom: 0; }
    .band-name { color: var(--forest-900); font-weight: 900; }
    .band-range { color: var(--muted); font-variant-numeric: tabular-nums; }
    .band-descriptors { margin: 0; padding-left: 17px; }
    .band-descriptors li + li { margin-top: 4px; }
    .mobile-bottom-nav { display: none; }
    .toast { position: fixed; right: 20px; bottom: 20px; z-index: 20; max-width: min(420px, calc(100% - 40px)); padding: 13px 16px; border: 1px solid #bde4c6; border-radius: 12px; color: var(--success); background: var(--success-soft); box-shadow: var(--shadow); font-weight: 750; }
    .toast.error { border-color: #f2c2c2; color: var(--danger); background: var(--danger-soft); }
    .toast[hidden] { display: none; }
    .site-footer { padding: 26px 0 32px; border-top: 1px solid var(--line); color: var(--muted); font-size: .79rem; }
    .site-footer-inner { display: flex; justify-content: space-between; gap: 16px; }
    .footer-links { display: flex; gap: 14px; flex-wrap: wrap; }
    .print-only { display: none; }
    @media (max-width: 980px) {
      .app-layout { grid-template-columns: 1fr; }
      .side-nav { display: none; }
      .menu-button { display: grid; }
      .mobile-bottom-nav { position: fixed; left: 10px; right: 10px; bottom: 10px; z-index: 9; display: grid; grid-template-columns: repeat(5, 1fr); gap: 3px; padding: 6px; border: 1px solid var(--line); border-radius: 17px; background: rgba(255, 253, 244, .94); box-shadow: var(--shadow); backdrop-filter: blur(14px); }
      .mobile-bottom-nav button { min-height: 44px; border: 0; border-radius: 11px; color: var(--muted); background: transparent; font-size: .67rem; font-weight: 850; }
      .mobile-bottom-nav button.active { color: var(--forest-950); background: var(--citrus-soft); }
      .mobile-bottom-nav button span { display: block; font-size: 1.03rem; line-height: 1.1; }
      .mobile-bottom-nav button em { display: block; font-style: normal; }
    }
    @media (max-width: 760px) {
      .header-inner, .page-shell, .site-footer-inner { width: min(100% - 22px, 1240px); }
      .page-shell { padding-top: 20px; }
      .header-inner { min-height: 64px; }
      .brand-subtitle { display: none; }
      .header-actions .button { display: none; }
      .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .split-grid, .form-grid.two, .form-grid.three { grid-template-columns: 1fr; }
      .screen-heading { display: block; }
      .heading-actions { margin-top: 13px; }
      .card-pad { padding: 16px; }
      .score-grid { gap: 7px; }
      .student-row { align-items: flex-start; flex-direction: column; }
      .student-row .button-row { width: 100%; }
      .student-row .button { flex: 1; }
      .band-item { grid-template-columns: 1fr; gap: 4px; }
      .band-descriptors { margin-top: 3px; }
      .site-footer-inner { display: block; }
      .footer-links { margin-top: 9px; }
    }
    @media (max-width: 430px) {
      .brand-title { font-size: .94rem; }
      .brand-mark { width: 37px; height: 37px; }
      .role-badge { padding: 6px 8px; font-size: .7rem; }
      h1 { font-size: 1.75rem; }
      .stats-grid { gap: 8px; }
      .stat-card { padding: 13px; }
      .stat-value { font-size: 1.35rem; }
      .score-input { padding: 10px 5px; }
    }
    @media print {
      .site-header, .side-nav, .mobile-bottom-nav, .site-footer, .screen-heading, .toast { display: none !important; }
      body { background: #fff; }
      .page-shell, .header-inner, .site-footer-inner { width: 100%; padding: 0; }
      .card { border: 0; box-shadow: none; }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Langkau ke kandungan</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="#dashboard" data-nav="dashboard" aria-label="Takraw Pentaksiran MPU3421">
        <span class="brand-mark" aria-hidden="true">T</span>
        <span><span class="brand-title">Takraw Pentaksiran</span><span class="brand-subtitle">MPU3421 · Penilaian berintegriti</span></span>
      </a>
      <div class="header-actions">
        <span id="role-badge" class="role-badge" hidden></span>
        <button id="header-menu-button" class="icon-button menu-button" type="button" data-action="toggle-menu" aria-label="Buka menu">☰</button>
        <button class="button secondary" type="button" data-action="sync" data-disable-while-busy hidden>Segar semula</button>
        <button class="button secondary" type="button" data-action="logout" data-disable-while-busy hidden>Log keluar</button>
      </div>
    </div>
  </header>

  <main id="main-content" class="page-shell">
    <section id="login-view" class="login-layout" aria-labelledby="login-title">
      <div class="login-card">
        <p class="eyebrow">Ruang penilai · Google Sheets</p>
        <h1 id="login-title">Selamat datang ke rekod takraw.</h1>
        <p class="muted">Log masuk sebagai penilai untuk memuatkan roster dan rekod sebenar daripada backend Apps Script. Tiada data penilaian disimpan dalam pelayar ini.</p>
        <div id="login-message" class="notice" role="alert"></div>
        <form id="login-form" class="form-grid" data-form="login" autocomplete="off">
          <div>
            <span class="field-label"><span>Peranan</span></span>
            <div class="login-role-row">
              <label class="role-option"><input type="radio" name="role" value="P1" checked><span>Penilai 1 (P1)</span></label>
              <label class="role-option"><input type="radio" name="role" value="P2"><span>Penilai 2 (P2)</span></label>
            </div>
          </div>
          <label><span>Kata laluan</span><input id="login-password" name="password" type="password" required autocomplete="current-password" maxlength="1024"></label>
          <button class="button primary" type="submit" data-disable-while-busy>Log masuk dan sync</button>
        </form>
        <p class="helper" style="margin-top:16px">Gunakan Code.gs dan index.html pakej yang sama. Kunci dalaman disediakan sendiri selepas log masuk sah pertama; tiada borang token atau fail aktivasi berasingan.</p>
      </div>
    </section>

    <section id="app-view" hidden>
      <div class="app-layout">
        <aside id="side-nav" class="side-nav" aria-label="Navigasi utama">
          <div class="side-nav-title">Ruang kerja</div>
          <ul class="nav-list">
            <li><button class="nav-link" type="button" data-nav="dashboard"><span class="nav-icon">01</span>Dashboard</button></li>
            <li><button class="nav-link" type="button" data-nav="students"><span class="nav-icon">02</span>Pelajar & amali</button></li>
            <li><button class="nav-link" type="button" data-nav="training"><span class="nav-icon">03</span>Latihan</button></li>
            <li><button class="nav-link" type="button" data-nav="rubric"><span class="nav-icon">04</span>Rubrik</button></li>
            <li><button class="nav-link" type="button" data-nav="results"><span class="nav-icon">05</span>Keputusan</button></li>
            <li><button class="nav-link" type="button" data-nav="settings"><span class="nav-icon">06</span>Tetapan</button></li>
            <li><button class="nav-link" type="button" data-nav="health"><span class="nav-icon">07</span>Kesihatan</button></li>
          </ul>
        </aside>
        <div id="screen-content" class="main-content" tabindex="-1"></div>
      </div>
    </section>
  </main>

  <nav id="mobile-bottom-nav" class="mobile-bottom-nav" aria-label="Navigasi mudah alih" hidden>
    <button type="button" data-nav="dashboard"><span>⌂</span><em>Utama</em></button>
    <button type="button" data-nav="students"><span>◫</span><em>Amali</em></button>
    <button type="button" data-nav="training"><span>◇</span><em>Latihan</em></button>
    <button type="button" data-nav="results"><span>▤</span><em>Keputusan</em></button>
    <button type="button" data-action="toggle-menu"><span>☰</span><em>Lagi</em></button>
  </nav>

  <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
  <footer class="site-footer">
    <div class="site-footer-inner">
      <span>Takraw Pentaksiran MPU3421 · Frontend GitHub Pages · Backend Google Apps Script</span>
      <span class="footer-links"><span data-sheet-link hidden>Google Workspace</span><span>Gred rujukan IPG bukan gred rasmi e-BPBP.</span></span>
